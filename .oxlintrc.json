{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "react", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2026": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "eslint/no-console": ["error", { "allow": ["error", "warn"] }],
    "eslint/no-empty": "off",
    "eslint/prefer-const": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "caughtErrors": "none"
      }
    ],

    "import/extensions": ["error", "ignorePackages"],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/config-client.js",
          "**/config-server.mjs",
          "**/*.css",
          "@testing-library/jest-dom/vitest"
        ]
      }
    ],

    "react/react-in-jsx-scope": "off",
    "react/no-unescaped-entities": "off",

    "oxc/no-async-endpoint-handlers": "off",

    // scripts/screenshot-ui.mjs describes each shot as a record with a `then`
    // step. Nothing ever awaits one, so they are not accidental thenables.
    "unicorn/no-thenable": "off",
    "unicorn/no-new-array": "off",

    // The suite predates these and reads fine without them; the three that
    // catch a mistake rather than a style are kept on below.
    "vitest/expect-expect": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-title": "off",
    "vitest/no-focused-tests": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-disabled-tests": "error",

    "typescript/no-non-null-assertion": "off",
    "typescript/no-empty-function": "off",
    "typescript/no-dynamic-delete": "off",
    "typescript/ban-ts-comment": "off",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/require-array-sort-compare": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/dot-notation": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      { "ignoreArrowShorthand": true }
    ],
    "typescript/no-mixed-enums": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/restrict-template-expressions": [
      "error",
      { "allowNumber": true }
    ],
    "typescript/no-base-to-string": "error",
    "typescript/unbound-method": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/require-await": "error",
    "typescript/prefer-nullish-coalescing": [
      "error",
      { "ignorePrimitives": { "string": true } }
    ],
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/prefer-optional-chain": "error",
    "typescript/return-await": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-floating-promises": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.{js,jsx,ts,tsx}", "src/setupTests.ts"],
      "rules": {
        "eslint/no-console": "off",
        "eslint/no-unused-vars": "off",
        "typescript/no-unused-vars": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // Type-aware rules that read untyped JS wrong, or whose fix is a type
      // annotation JS can only spell as JSDoc. Everything else in the
      // type-aware set — no-floating-promises above all — still applies here.
      //
      // The first three infer too narrowly: `config.BACKEND_URL === false` is
      // how the gh-pages build selects the in-browser backend, and dropping
      // the "useless" `height = 900` in screenshot-ui.mjs would break the one
      // shot that omits `height`.
      "files": ["**/*.mjs", "**/*.js"],
      "rules": {
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-boolean-literal-compare": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["src/fetchAndParse.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/components/HeaderForm.tsx"],
      "rules": {
        "react/exhaustive-effect-dependencies": "off"
      }
    },
    {
      "files": [
        "src/server.mjs",
        "src/vg.ts",
        "src/**/__mocks__/**",
        "src/config-*.{js,mjs}",
        "src/components/TubeMap.tsx"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "build",
    "dist",
    "tmp",
    "public",
    "node_modules",
    "vite.config.mjs"
  ]
}
